{
  "name": "requirement-pool-local",
  "version": "1.0.0",
  "description": "多项目需求池本地管理软件：CLI + 本地服务 + SQLite + 浏览器管理页",
  "type": "module",
  "bin": {
    "reqpool": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts start --host 127.0.0.1 --port 8080",
    "start": "node dist/cli.js start --open",
    "build": "tsc && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "commander": "^14.0.1",
    "env-paths": "^3.0.0",
    "fastify": "^5.6.1",
    "open": "^10.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED",
  "private": true
}
